{
  "name": "@leavepulse/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "LeavePulse token-driven Vue component kit.",
  "files": ["dist", "src/tokens/tokens.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/tokens/tokens.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build --config vite.lib.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify/vue": "^5.0.0",
    "motion-v": "^2.2.0",
    "reka-ui": "^2.9.0",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.112",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "motion-v": "^2.2.1",
    "reka-ui": "^2.9.10",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^5.0.2",
    "vue": "3.5.33",
    "vue-tsc": "^3.0.0"
  }
}
